# Copiá este archivo a .env y completalo. El .env NO se sube al repo.
# Paso a paso para conseguir cada valor: docs/WHATSAPP.md

# --- Kev ---
KEV_URL=http://127.0.0.1:8009
KEV_LANG=en

# --- WhatsApp Business (Cloud API de Meta) ---
# Un texto cualquiera que inventás vos; lo vas a pegar también en el panel de Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Panel de Meta → tu app → Configuración de la app → Básica → Clave secreta de la app.
# Con esto se verifica que cada mensaje lo mande Meta de verdad (obligatorio).
WHATSAPP_APP_SECRET=

# Sólo si querés que Kev le responda al cliente (WhatsApp → Configuración de la API):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AUTO_REPLY=0
WHATSAPP_GRAPH_VERSION=v25.0

# 1 = mostrar el nombre del perfil de WhatsApp en vez de "Contacto N" (el teléfono nunca se muestra).
WHATSAPP_SHOW_NAMES=0
# 1 = aceptar mensajes sin firma. SÓLO para probar en local con scripts/simular_whatsapp.py.
WHATSAPP_ALLOW_UNSIGNED=0

# --- Columnas ---
# Archivo con las áreas que decide Kev (por defecto config/areas.json).
# AREAS_FILE=config/areas.tienda-online.json
